# Postgres — service-role connection (Supabase session pooler :5432 or direct).
SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# Google OAuth client (Drive connector) — https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Gemini embeddings — MUST match the Next.js app (gemini-embedding-001 @ 768d).
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# Sync tuning / backpressure
SYNC_MAX_CONCURRENCY=4
SYNC_BATCH_SIZE=25
EMBED_BATCH_SIZE=16
EMBED_MAX_CONCURRENCY=2
HTTP_MAX_RETRIES=5

# Retrieval / synthesis (Part 4) — all Gemini, free tier; reuses GEMINI_API_KEY
RETRIEVAL_MODE=rpc                 # rpc | app
RETRIEVAL_CANDIDATES=25
ANSWER_TOP_K=5
RERANK_MODEL=gemini-3.1-flash-lite
CRAG_MODEL=gemini-3.1-flash-lite
CRAG_THRESHOLD=0.65
SYNTHESIS_MODEL=gemini-2.5-flash
SYNTHESIS_MAX_TOKENS=2048
# Supabase project JWT secret (Dashboard -> Settings -> API -> JWT Settings)
SUPABASE_JWT_SECRET=
